# Copia este archivo a `.env` (`cp .env.example .env`) y ajusta lo que haga
# falta. `.env` es tu entorno de DESARROLLO: nunca debe contener la base ni el
# blob de producción. Producción se alcanza solo a propósito, con `.env.prod` y
# `npm run prod -- <comando>` (ver docs/runbooks/bases-de-datos.md).
#
# Qué archivo lee quién:
#   .env         -> `npm run dev` y el CLI de Payload (desarrollo)
#   .env.test    -> `npm run test:int` y `npm run test:e2e` (commiteado, sin secretos)
#   .env.prod    -> solo `npm run prod -- ...`, nunca de forma automática
#   Vercel       -> producción de verdad; no sale de este repo

# --- Obligatorias ---

# Base de desarrollo. Este es el Postgres local de `docker-compose.yml`, que
# levantas con `npm run db:up`. No hace falta pedirle credenciales a nadie.
DATABASE_URL=postgres://notoriovs:notoriovs@localhost:5432/notoriovs_dev

# Firma las sesiones del admin y de los usuarios de tenant. En desarrollo
# cualquier cadena larga sirve; NO reuses la de producción.
# Genera una con: openssl rand -hex 32
PAYLOAD_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Opcionales ---

# Dominio raíz desde el que se derivan los subdominios de tenant. Si no la
# defines, el middleware usa 'notoriovs.com'. En local, para probar hosts de
# tenant, apunta algo como acme.localhost:3000 y pon ROOT_DOMAIN=localhost.
# ROOT_DOMAIN=localhost

# Almacenamiento de media. SIN este token, los uploads se guardan en la carpeta
# local `media/` y no se toca el blob de producción — que es justo lo que
# quieres en desarrollo. Solo defínelo si necesitas probar el blob de verdad, y
# entonces usa un store aparte, no el de producción.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx_xxxxxxxx

# Llave que exige el endpoint /api/marketing-reports/ingest (el workflow de
# n8n). Sin ella ese endpoint responde 500 a propósito.
# MARKETING_REPORT_INGEST_KEY=llave-de-desarrollo

# Llave que exige el endpoint /api/leads/ingest (el mismo n8n, para los leads
# que no pasan por el quiz). Aparte de la anterior a propósito: rotar una no
# apaga la otra. Sin ella ese endpoint rechaza todo.
# LEADS_INGEST_KEY=llave-de-desarrollo

# Id de Google Ads para las conversiones del quiz. Sin ella no se envían.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Correo transaccional (recuperación de contraseña e invitaciones). SIN esta
# llave no se manda ningún correo: Payload imprime el mensaje en la terminal,
# enlace incluido, que es lo que quieres en desarrollo. Pídesela a quien
# administre la cuenta de SendGrid solo si necesitas probar el envío real, y
# usa entonces un remitente de prueba.
# SENDGRID_API_KEY=SG.xxxxxxxx

# Buzón desde el que sale todo el correo del sistema. Tiene que estar
# verificado en SendGrid (dominio de Notoriovs). El nombre visible NO es este:
# es el de la empresa del Tenant, y lo pone el código en cada envío.
# EMAIL_FROM_ADDRESS=no-reply@notoriovs.com
# EMAIL_FROM_NAME=Notoriovs
